{
  "name": "@kodi/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.functions.json && tsc -b && vite build",
    "types": "wrangler types worker-configuration.d.ts",
    "pages:dev": "wrangler pages dev",
    "pages:deploy:preview": "wrangler pages deploy --branch preview",
    "pages:deploy:production": "wrangler pages deploy --branch main",
    "test": "vitest run",
    "lint": "eslint src functions --max-warnings=0"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.0.0",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
