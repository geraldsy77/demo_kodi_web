NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=8181
WEB_DIST_PATH=/volume1/web/kodi-web/apps/web/dist

# Use a dedicated SELECT-only KODI MariaDB account.
KODI_DB_HOST=127.0.0.1
KODI_DB_PORT=3306
KODI_DB_USER=kodi_web_readonly
KODI_DB_PASSWORD=replace-with-the-read-only-password

# Set this to the database verified by discovery; never guess the suffix.
KODI_VIDEO_DB=MyVideosXXX
