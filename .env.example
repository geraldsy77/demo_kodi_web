# Stage 1 production API (Docker Compose sets NODE_ENV=production)
# API_PORT is the API container port and must match the nginx upstream.
NODE_ENV=production
API_PORT=3001

# MariaDB — use a dedicated SELECT-only account on the private LAN
KODI_DB_HOST=192.168.0.3
KODI_DB_PORT=3306
KODI_DB_USER=kodi_web_readonly
KODI_DB_PASSWORD=replace-with-a-strong-password

# Set this only after running discovery; never guess the suffix
KODI_VIDEO_DB=MyVideos121

# Stage 2 local sync agent. The endpoint must use HTTPS and the token must match
# the Cloudflare Worker secret named SYNC_TOKEN.
KODI_SYNC_ENDPOINT=https://your-worker.example.com/api/internal/sync/snapshots
KODI_SYNC_TOKEN=replace-with-the-worker-sync-token
KODI_SYNC_BATCH_SIZE=50
KODI_SYNC_MAX_RETRIES=4
KODI_SYNC_STATE_FILE=.kodi-sync-state.json
KODI_SYNC_STATUS_FILE=.kodi-sync-status.json
# Set true to query and validate a complete export without uploading it.
KODI_SYNC_DRY_RUN=false
